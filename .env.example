# ==============================================================================
# GOVERNMENT JOB PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Phase 10: Production Deployment & Security Audit
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the backend directory:
#    cp .env.example backend/.env
# 2. In production, provide strong, securely generated secrets.
# 3. DO NOT commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Port on which the Express backend server listens
PORT=5000

# Runtime environment: 'development' | 'production' | 'test'
# In production, detailed stack traces are masked, and strict security headers are applied.
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Explicit frontend origin. Do NOT use '*' in production.
# Examples:
#   Development: http://localhost:5173
#   Production:  https://jobs.recruitment.gov.in
CORS_ORIGIN=https://jobs.recruitment.gov.in

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gov_portal_user
DB_PASSWORD=your_strong_database_password_here
DB_NAME=government_job_portal
DB_CONNECTION_LIMIT=15

# ------------------------------------------------------------------------------
# 4. JWT (JSON WEB TOKEN) AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographically strong secret key (minimum 32-64 characters recommended)
# Generate via: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. INITIAL ADMINISTRATIVE SEEDING CREDENTIALS
# ------------------------------------------------------------------------------
# Used ONLY for initial system bootstrapping (npm run seed:admin)
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@recruitment.gov.in
ADMIN_PASSWORD=your_strong_admin_bootstrap_password_here

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
# General API rate limit window in minutes and maximum requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Strict rate limit for authentication endpoints (login, registration)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
