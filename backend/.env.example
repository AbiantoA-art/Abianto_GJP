# ==============================================================================
# GOVERNMENT JOB PORTAL — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Phase 10: Production Deployment & Security Audit
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=production

# CORS Security (Explicit production origin, no wildcard)
CORS_ORIGIN=https://jobs.recruitment.gov.in

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gov_portal_user
DB_PASSWORD=your_strong_database_password_here
DB_NAME=government_job_portal
DB_CONNECTION_LIMIT=15

# JWT Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# Initial Admin Seeding Credentials (seed:admin)
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@recruitment.gov.in
ADMIN_PASSWORD=your_strong_admin_bootstrap_password_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
